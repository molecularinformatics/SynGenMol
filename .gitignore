# ...except the two published demonstrations, which are part of the release.
# Git only matches files whose parent directories are themselves re-admitted,
# so each level is unignored before its contents are selected.
!/outputs/
/outputs/*
!/outputs/syngenmol_demo_unconstraint/
/outputs/syngenmol_demo_unconstraint/*
!/outputs/syngenmol_demo_unconstraint/results/
!/outputs/syngenmol_demo_warhead_constraint/
/outputs/syngenmol_demo_warhead_constraint/*
!/outputs/syngenmol_demo_warhead_constraint/results/
/wandb/
/logs/
/cache/
/models/
*.slurm
slurm-*.out
slurm-*.err
*.pt
*.pth
*.ckpt
*.bin
*.pkl
*.pickle

